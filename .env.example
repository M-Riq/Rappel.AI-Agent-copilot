LLM_PROVIDER=fake               # fake | meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_MODEL_RAPIDE=
METERLESS_MODEL_PROFOND=
SOURCE_PROVIDER=fichier         # fichier | zetaris
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
MEMOIRE_PROVIDER=json           # json | postgres
MEMOIRE_JSON_PATH=data/memoire.json
# Identifiant local de démonstration, utilisé aussi comme mot de passe.
POSTGRES_LOCAL=rappel
DATABASE_URL=postgresql://${POSTGRES_LOCAL}:${POSTGRES_LOCAL}@localhost:5432/rappel
SEUIL_ABSTENTION=0.6
MAX_TOURS_ENQUETE=6
LLM_MAX_APPELS=20              # plafond d'appels LLM par enquête
LLM_APPEL_OUTILS=0             # 1 = appels d'outils natifs run_sql (tool_calls)
PIPELINE_DEMO_DIR=data/pipeline_demo   # pipeline de démo isolé (ignoré par git)
RAYON_SEUIL_AUTO=0.9             # rayon d'impact : confiance minimale pour auto
RAYON_SEUIL_VALIDATION=0.6       # en dessous : refus
RAYON_MAX_ELEMENTS=3             # au-delà : refus
RAYON_ELEMENTS_CRITIQUES=production,paiement,facturation,securite
ACTION_REELLE_DEMO=0             # 1 = l'API applique un correctif accepté au pipeline de démo uniquement
API_URL=http://127.0.0.1:8000
# Traces Langfuse optionnelles : vides = desactivees (aucune cle dans ce fichier).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_ENVOYER_TEXTES=1
BOUCLE_JOURNAL_PATH=data/boucle_journal.jsonl   # journal de la boucle des 4 agents (sans secret)
# War room (débat borné : sceptique/avocat du diable, détective, arbitre = code) ; désactivée par défaut.
WAR_ROOM_ACTIVE=0
WAR_ROOM_MAX_TOURS=2
WAR_ROOM_MAX_APPELS_LLM=6
