LLM_PROVIDER=fake               # fake | meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_MODEL_RAPIDE=
METERLESS_MODEL_PROFOND=
SOURCE_PROVIDER=fichier         # fichier | zetaris
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
MEMOIRE_PROVIDER=json           # json | postgres
MEMOIRE_JSON_PATH=data/memoire.json
# Identifiant local de démonstration, utilisé aussi comme mot de passe.
POSTGRES_LOCAL=rappel
DATABASE_URL=postgresql://${POSTGRES_LOCAL}:${POSTGRES_LOCAL}@localhost:5432/rappel
SEUIL_ABSTENTION=0.6
MAX_TOURS_ENQUETE=6
LLM_MAX_APPELS=20              # plafond d'appels LLM par enquête
LLM_APPEL_OUTILS=0             # 1 = appels d'outils natifs run_sql (tool_calls)
API_URL=http://127.0.0.1:8000
